---
import { SITE } from "../data/site";
import { L, useT, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<footer class="wrap">
  <div class="foot">
    <ul class="socials">
      {SITE.socials.map((s) => (
        <li>
          {(s as any).action === "cv"
            ? <button type="button" class="socials__btn" data-cv-open aria-haspopup="dialog">{L(s.label, lang)}</button>
            : <a href={(s as any).href} target="_blank" rel="noopener">{L(s.label, lang)}<span class="vh"> {t("a11y.newTab")}</span></a>}
        </li>
      ))}
    </ul>
    <div class="legal">
      <span>&copy; {new Date().getFullYear()} {SITE.name}. {t("foot.rights")}</span>
      <span>{SITE.location} &middot; <span class="tab" data-clock={SITE.timezone}>00:00</span> {SITE.tzLabel}</span>
      <a href={`https://${SITE.domain}`} target="_blank" rel="noopener">{SITE.domain}<span class="vh"> {t("a11y.newTab")}</span></a>
    </div>
  </div>
</footer>

<dialog class="cv" id="cv-dialog" aria-labelledby="cv-title">
  <form method="dialog" class="cv__box">
    <h2 id="cv-title">{t("cv.title")}</h2>
    <p>{t("cv.body")}</p>
    <div class="cv__actions">
      <a class="cv__btn" href={`mailto:${SITE.email}?subject=${encodeURIComponent(t("cv.subject"))}`}>{t("cv.email")}</a>
      <a class="cv__btn" href={`${SITE.whatsapp}?text=${encodeURIComponent(t("cv.text"))}`} target="_blank" rel="noopener">{t("cv.wa")}<span class="vh"> {t("a11y.newTab")}</span></a>
    </div>
    <button class="cv__close" value="close" aria-label={t("cv.close")}>{t("cv.close")}</button>
  </form>
</dialog>

<script>
  const dlg = document.getElementById("cv-dialog") as HTMLDialogElement | null;
  document.querySelectorAll("[data-cv-open]").forEach((b) => b.addEventListener("click", () => dlg?.showModal()));
  // Click on the backdrop closes the popup.
  dlg?.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
</script>
