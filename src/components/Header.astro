---
import { SITE } from "../data/site";
import { L, url, useT, type Lang } from "../lib/i18n";

interface Props { lang: Lang; path: string; article?: boolean }
const { lang, path, article } = Astro.props;
const t = useT(lang);

const links = [
  { href: "/#work", key: "nav.work", page: "/work" },
  { href: "/#archive", key: "nav.archive", page: "/archive" },
  { href: "/#about", key: "nav.about" },
  { href: "/#contact", key: "nav.contact" },
];
const themes = [
  { id: "light", icon: '<circle cx="7" cy="7" r="2.6"/><path d="M7 .8v1.6M7 11.6v1.6M.8 7h1.6M11.6 7h1.6M2.6 2.6l1.1 1.1M10.3 10.3l1.1 1.1M2.6 11.4l1.1-1.1M10.3 3.7l1.1-1.1"/>' },
  { id: "dark", icon: '<path d="M11.8 8.6A5 5 0 0 1 5.4 2.2a5 5 0 1 0 6.4 6.4Z"/>' },
  { id: "system", icon: '<rect x="1.2" y="2" width="11.6" height="7.8" rx="1.2"/><path d="M5 12.4h4M7 9.8v2.6"/>' },
];
---

<header class="nav" id="nav" data-open="false" data-route={article ? "detail" : "page"}>
  <div class="wrap nav__inner">
    <a class="brand" href={url(lang, "/")}><span>{SITE.name}</span><small>{t("brand.role")}</small></a>
    <div class="nav__right">
      <nav class="nav__links" id="nav-links" aria-label={t("nav.aria")}>
        {links.map((l) => (
          <a href={url(lang, l.href)} aria-current={l.page && path.startsWith(l.page) ? "page" : undefined}>{t(l.key)}</a>
        ))}
      </nav>
      <div class="theme" id="theme" role="group" aria-label={t("theme.aria")}>
        {themes.map((th) => (
          <button type="button" data-theme={th.id} aria-pressed={th.id === "system" ? "true" : "false"} aria-label={t(`theme.${th.id}`)} title={t(`theme.${th.id}T`)}>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" set:html={th.icon} />
          </button>
        ))}
      </div>
      <a class="status" href={url(lang, "/#contact")} data-open={String(SITE.availability.open)} aria-label={L(SITE.availability.label, lang)}>
        <span class="dot" aria-hidden="true"></span>
        <span class="status__label">{L(SITE.availability.label, lang)}</span>
        <span class="status__short">{L(SITE.availability.short, lang)}</span>
      </a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav-links" data-open-label={t("menu.open")} data-close-label={t("menu.close")}>{t("menu.open")}</button>
    </div>
  </div>
  <span class="progress" id="progress" aria-hidden="true"></span>
</header>
